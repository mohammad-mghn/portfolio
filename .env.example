# Sanity (leave empty to run on the local seed in content/seed)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Public site URL (canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://mghn.info

# Webhook secret for /api/revalidate (set the same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=

# Optional: Viewer token, only needed for drafts / preview
SANITY_API_READ_TOKEN=

# Local only — never add to Vercel. Editor token used by `pnpm seed`.
SANITY_API_WRITE_TOKEN=
